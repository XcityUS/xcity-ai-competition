    "A01",
    "B03",
    "C02"
  ],
  "nodes_reason": "Housing and shared ground test independent daily life; useful compute tests civic production; the working farm edge connects the city to the protected productive pilot.",
  "tradeoff": {
    "objective": "Maximum uninterrupted compute throughput and minimum productive-route length",
    "why": "Independent housing, public life and a clear service boundary take precedence.",
    "consequence": "Flexible IT output, additional maintenance and walking connections, shared-space funding obligations.",
    "who_bears": "Compute investors and operators through interruption contracts; public-service funding must not depend on uninterrupted IT revenue."
  },
