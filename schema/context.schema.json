{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional external study context; excluded from construction accounts",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object"
          },
          "properties": {
            "type": "object",
            "required": [
              "status",
              "authority",
              "basis"
            ],
            "properties": {
              "status": {
                "const": "study_only"
              },
              "authority": {
                "const": "not_secured"
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
