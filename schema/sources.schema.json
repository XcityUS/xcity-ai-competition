{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XCITY AI Competition - sources.json",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "accessed": {
            "type": "string"
          },
          "used_for": {
            "type": "string"
          }
        }
      }
    }
  }
}
