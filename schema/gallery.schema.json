{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XCITY AI Competition - gallery-publication.json and awards.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "published": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reviewed_package_sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reviewed_package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "published_at": {
            "type": "string"
          },
          "featured": {
            "type": "boolean"
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "proposed",
              "tbd"
            ]
          }
        }
      }
    }
  }
}
